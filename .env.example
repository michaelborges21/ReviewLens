# Copie para .env e preencha os valores reais. .env nunca vai para o git.

# Salt para pseudonimização de user_id na camada processed (spec 01).
# Única variável realmente exigida hoje: sem ela, o processamento para com erro explícito.
USER_ID_HASH_SALT=

# Ollama: só a URL e os modelos. Padrões valem para esta máquina (ADR-004); trocar não exige
# editar código — útil em máquina sem GPU ou para repetir a medição com outro modelo.
# OLLAMA_URL=http://localhost:11435
# OLLAMA_MODELO=gemma4:12b
# OLLAMA_MODELO_EMBEDDING=embeddinggemma

# Teto de espera da narração do chat, em segundos. 60 cobre a GPU medida aqui; em CPU o mesmo
# modelo leva muito mais, e sem aumentar isso toda resposta degradaria para o texto determinístico.
# TIMEOUT_CHAT_SEGUNDOS=60

# Cotação usada só para converter custo de referência em real (src/bri/llm/custo.py).
# Opcional: sem ela, vale o padrão datado no código.
# USD_BRL=

# O projeto NÃO usa chave de API de LLM (ADR-004 e ADR-011): o enriquecimento roda em
# gemma4:12b local, via Ollama. Se um dia houver provider comercial, não precisa ser a
# Anthropic — a camada src/bri/llm/ é intercambiável por desenho. Exemplos inativos:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
